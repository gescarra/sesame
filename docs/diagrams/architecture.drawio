calAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.parameter_store;labelBackgroundColor=default;" vertex="1" parent="ops"><mxGeometry x="396" y="46" width="48" height="48" as="geometry"/></mxCell><mxCell id="logs" value="Amazon CloudWatch&lt;br&gt;Logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;labelBackgroundColor=default;" vertex="1" parent="ops"><mxGeometry x="566" y="46" width="48" height="48" as="geometry"/></mxCell><mxCell id="step1" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="recv"><mxGeometry x="36" y="56" width="24" height="24" as="geometry"/></mxCell><mxCell id="step2" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="recv"><mxGeometry x="546" y="56" width="24" height="24" as="geometry"/></mxCell><mxCell id="step3" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="cloud"><mxGeometry x="140" y="628" width="24" height="24" as="geometry"/></mxCell><mxCell id="step4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="web"><mxGeometry x="176" y="36" width="24" height="24" as="geometry"/></mxCell><mxCell id="step5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="web"><mxGeometry x="450" y="278" width="24" height="24" as="geometry"/></mxCell><mxCell id="step6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="send"><mxGeometry x="376" y="36" width="24" height="24" as="geometry"/></mxCell><mxCell id="step7" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="send"><mxGeometry x="856" y="36" width="24" height="24" as="geometry"/></mxCell><mxCell id="step8" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="web"><mxGeometry x="176" y="386" width="24" height="24" as="geometry"/></mxCell><mxCell id="step9" value="9" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="ops"><mxGeometry x="46" y="26" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_step1" value="1" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="1360" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text1" value="Senders look up the MX record and deliver over SMTP to Amazon SES. The receipt rule stores the raw MIME in S3 and publishes to SNS." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="234" y="1362" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step2" value="2" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="1360" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text2" value="SQS buffers each message for the ingest function, which parses and sanitizes it, indexes search tokens and delivers it to each mailbox." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="814" y="1362" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step3" value="3" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1360" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text3" value="One CloudFront distribution serves the web app from S3 and signs /api/* and /admin/* requests to the Web Functions with origin access control." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1394" y="1362" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step4" value="4" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="1416" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text4" value="Cognito federates sign-in to your SAML or OIDC identity provider. The API exchanges the code and keeps a session cookie." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="234" y="1418" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step5" value="5" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="1416" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text5" value="The mail API reads and writes mail in DynamoDB and S3. It queues local recipients for ingest and external recipients for sending." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="814" y="1418" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step6" value="6" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1416" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text6" value="The sender function sends through SES, which delivers over SMTP to the recipients' mail servers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1394" y="1418" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step7" value="7" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="200" y="1472" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text7" value="SES publishes deliveries, bounces and complaints. The ses-events function updates delivery status and the suppression list." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="234" y="1474" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step8" value="8" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="1472" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text8" value="The admin console manages domains, mailboxes, quotas and aliases and redrives dead-lettered mail. Its role can't read mail." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="814" y="1474" width="520" height="48" as="geometry"/></mxCell><mxCell id="legend_step9" value="9" style="ellipse;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1472" width="24" height="24" as="geometry"/></mxCell><mxCell id="legend_text9" value="CloudWatch alarms on dead letters, queue age, API errors and SES reputation, and notifies operators by email." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1394" y="1474" width="520" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>