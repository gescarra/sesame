region = "us-east-1"
name   = "sesame"
domain = "example.com"

# Write DNS records to Route 53 (omit to manage DNS elsewhere):
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# dmarc_report_address = "dmarc@example.com"

# Sign-in. Configure at least one IdP, or allow native Cognito users while testing.
# allow_cognito_users = true
# identity_providers = [{
#   name              = "Okta"
#   type              = "OIDC"
#   attribute_mapping = { email = "email", name = "name" }
#   details = {
#     client_id                 = "..."
#     client_secret             = "..."
#     oidc_issuer               = "https://example.okta.com"
#     authorize_scopes          = "openid email profile"
#     attributes_request_method = "GET"
#   }
# }]

# Alarms and an optional cost budget. SNS emails each address a confirmation link first.
# alarm_emails       = ["ops@example.com"]
# monthly_budget_usd = 10

# Serve the web app and API on your own hostname instead of *.cloudfront.net. With route53_zone_id
# set, sesame issues the ACM certificate and creates the DNS records. Otherwise, pass a us-east-1
# certificate in web_certificate_arn and point the name at the cloudfront_domain_name output.
# web_domain = "mail.example.com"


# Push mail to phones on ActiveSync (iOS "Fetch New Data" set to Push). A waiting phone keeps one
# Web Function environment active all month, about $1.90 shared by up to 64 phones. Off, phones
# fetch on their own schedule (every 15 minutes at most) and cost a few cents each.
# eas_push = true
#
# Each push request lasts 10 seconds less than CloudFront's origin read timeout: 50 seconds by
# default. For longer ones (fewer requests, less battery), raise the CloudFront quota "Response
# timeout per origin" to 180 in Service Quotas first, then:
# eas_origin_read_timeout = 180
