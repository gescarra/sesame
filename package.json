{
  "name": "sesame",
  "private": true,
  "description": "Open-source serverless email built on Amazon SES",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
